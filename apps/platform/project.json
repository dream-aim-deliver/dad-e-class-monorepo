{
    "name": "platform",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/platform",
    "projectType": "application",
    "tags": [],
    "implicitDependencies": ["ui-kit", "models", "translations"],
    "targets": {
        "build": {
            "// dependsOn": "Nx 24 infers ^typecheck for next build; keep the pre-upgrade ^build-only chain (ui-kit typecheck has pre-existing story errors)",
            "dependsOn": ["^build"]
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "apps/platform",
                "command": "eslint ."
            }
        },
        "test": {
            "options": {
                "config": "./vitest.config.ts"
            }
        }
    }
}
